# 리워들 환경 변수 설정

# === Supabase (필수) ===
# Supabase 대시보드에서 확인: Settings → API
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# === Gemini AI (필수 - AI 미션 생성용) ===
# 발급: https://aistudio.google.com/app/apikey
# ⚠️ 무료 API는 분당 요청 제한이 있으니 주의하세요
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# === 온누리상품권 API (선택) ===
# 가맹점 검색 기능에 사용 (없어도 앱 작동)
# 발급: https://www.data.go.kr
VITE_ONNURI_API_KEY=your_onnuri_api_key_here

# === 기타 API 키 (향후 확장용) ===
# VITE_NAVER_MAP_API_KEY=
# VITE_KAKAO_MAP_API_KEY=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📝 사용 방법:
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 1. 이 파일을 .env로 복사: cp .env.example .env
# 2. 각 API 키를 실제 값으로 교체
# 3. 개발 서버 시작: npm run dev
# 
# ⚠️ 주의사항:
# - .env 파일은 절대 GitHub에 커밋하지 마세요 (.gitignore 등록됨)
# - API 키 변경 후 반드시 개발 서버 재시작 필요
# - 브라우저 콘솔에서 geminiTest.runAll()로 API 연결 테스트
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
