# 리워들 환경 변수 설정

# === Supabase (필수) ===
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# === AI 미션 생성 (둘 중 하나 이상 설정) ===
# CLOVA Studio (우선 사용): /api/clova-chat 프록시로 호출 → Vercel 대시보드에만 설정
#   Vercel 환경 변수: CLOVA_STUDIO_API_KEY (NCP CLOVA Studio에서 발급한 API 키)
#   CLOVA_STUDIO_ENDPOINT (선택, 기본 HCX-005)
# 프론트엔드 .env에는 CLOVA 키 불필요 (프록시가 서버에서 호출)
# VITE_CLOVA_STUDIO_ENDPOINT=HCX-005
# 로컬에서 CLOVA 테스트 시: 배포 URL을 넣으면 /api 요청이 그쪽으로 프록시됨 (npm run dev 재시작 필요)
# VITE_CLOVA_PROXY_TARGET=https://your-app.vercel.app
# Gemini (폴백): https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# === 온누리상품권 API (가맹점 검색용, 선택) ===
# 발급: https://www.data.go.kr
VITE_ONNURI_API_KEY=your_onnuri_api_key_here

# === 기타 API 키 (향후 확장용) ===
# VITE_NAVER_MAP_API_KEY=
# VITE_KAKAO_MAP_API_KEY=

# ⚠️ 주의사항:
# 1. 이 파일을 .env로 복사하여 사용하세요
# 2. API 키는 절대 GitHub에 커밋하지 마세요
# 3. .env 파일 수정 후 개발 서버를 재시작하세요 (npm run dev)
